rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // One profile doc per signed-in user: { nickname, nicknameEdited, createdAt }
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Nickname reservation docs, keyed by lowercase nickname: { uid, nickname }
    // Ownership can never be stolen — only the current holder may
    // overwrite or free their own entry (handled via a transaction
    // client-side, but enforced here too).
    match /nicknames/{nameKey} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Visited-planet entries: { uid, nickname, priority, galaxy, address, biome, notes, dateAdded, createdAt }
    match /planets/{planetId} {
      // Any signed-in user can read (needed for "All Registered" view).
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
